{
  "manifest_version": 3,
  "name": "KeyFix AI — اصلاح هوشمند زبان تایپ",
  "version": "1.2.0",
  "description": "تشخیص و اصلاح محلی عبارت‌های فارسی و انگلیسی تایپ‌شده با چیدمان اشتباه کیبورد.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "KeyFix AI — اصلاح زبان تایپ",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "keyboard.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "convert-selection": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "تبدیل متن انتخاب‌شده یا عبارت زیر مکان‌نما"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
